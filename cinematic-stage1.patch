diff --git a/src/history/qc/audio.ts b/src/history/qc/audio.ts
new file mode 100644
index 0000000..af56c3e
--- /dev/null
+++ b/src/history/qc/audio.ts
@@ -0,0 +1,53 @@
+import { fmt, type Ctx } from "./util";
+
+const SFX_FOR: Record<string, string[]> = {
+  cannon: ["cannon.wav"], muzzle: ["musket.wav", "cannon.wav"], splash: ["splash.wav"],
+  lightning: ["thunder.wav"], grapple: ["hook.wav"], debris: ["crack.wav", "thud.wav"],
+};
+
+export const checkAudio = (c: Ctx, durations: Record<string, number> | null | undefined, files: Set<string> | null | undefined) => {
+  const { ep } = c;
+  const K = "audio";
+
+  // narration length vs. its slot (subtitle windows and ducking depend on it)
+  if (!durations) c.add(K, "info", "Narration audio has not been generated (no manifest.json), so spoken length vs. slot could not be verified. Run `node scripts/generate-audio.mjs`.");
+  else {
+    ep.narration.forEach((n, i) => {
+      const d = durations[n.id];
+      if (d === undefined) return c.add(K, "error", `No generated audio duration for ${n.id}.`, n.start);
+      const slot = n.end - n.start;
+      const next = ep.narration[i + 1];
+      if (next && n.start + d > next.start - 0.05) c.add(K, "error", `${n.id} audio (${d.toFixed(2)}s) runs into ${next.id}.`, n.start);
+      else if (d > slot + 0.4) c.add(K, "warn", `${n.id} audio is ${d.toFixed(2)}s but its slot is ${slot.toFixed(2)}s; subtitles will lag the voice.`, n.start);
+      if (n.start + d > ep.durationSec - 0.3) c.add(K, "error", `${n.id} audio runs past the end fade.`, n.start);
+    });
+  }
+
+  // every sound-making event needs a cue near it
+  for (const e of ep.fx) {
+    const want = SFX_FOR[e.kind];
+    if (!want) continue;
+    const ok = ep.sfx.some((s) => want.includes(s.file) && Math.abs(s.t - e.t) <= 0.4);
+    if (!ok) c.add(K, "warn", `${e.kind} event at ${fmt(e.t)} has no matching sound cue within 0.4s (${want.join(" / ")}).`, e.t);
+  }
+  // scene changes should be carried by a whoosh
+  for (const tr of ep.transitions) {
+    const ok = ep.sfx.some((s) => s.file.startsWith("whoosh") && Math.abs(s.t - (tr.t - tr.dur * 0.1)) <= 0.9);
+    if (!ok) c.add(K, "warn", `Transition at ${fmt(tr.t)} has no whoosh cue.`, tr.t);
+  }
+  // cue files must exist
+  if (files) {
+    const used = new Set([ep.music.file, ep.ambience.file, ...ep.sfx.map((s) => s.file), ...ep.narration.map((n) => n.id + ".wav")]);
+    for (const f of used) if (!files.has(f)) c.add(K, "error", `Audio file "${f}" is referenced but is not produced by the audio generator.`);
+  } else c.add(K, "info", "Audio file list unknown; skipped file-existence check.");
+
+  const cues = [...ep.sfx].sort((a, b) => a.t - b.t);
+  let stack = 0;
+  for (let i = 0; i < cues.length; i++) {
+    let n = 0;
+    for (let j = i; j < cues.length && cues[j].t - cues[i].t < 0.1; j++) n++;
+    stack = Math.max(stack, n);
+  }
+  if (stack > 3) c.add(K, "warn", `Up to ${stack} sound cues fire within 100ms of each other; the mix will clip or smear.`);
+  c.metrics.sfxCues = ep.sfx.length;
+};
diff --git a/src/history/qc/camera.ts b/src/history/qc/camera.ts
new file mode 100644
index 0000000..4a28558
--- /dev/null
+++ b/src/history/qc/camera.ts
@@ -0,0 +1,152 @@
+import { waveHeight } from "../world/waves";
+import { hgt } from "../world/Island";
+import { len3, norm3, sub3 } from "../engine/math";
+import type { Shot } from "./types";
+import { charHeight, fmt, inFrame, median, project, runs, type Ctx } from "./util";
+
+/** Largest character-height fraction of the frame among characters in view at frame i. */
+export const faceFraction = (c: Ctx, i: number) => {
+  const f = c.frames[i];
+  let best = 0;
+  for (const ch of c.ep.chars) {
+    const p = c.R.charWorld(ch, f.t);
+    const H = charHeight(ch.scale);
+    const pr = project(f.cam, [p[0], p[1] + H * 0.5, p[2]], c.aspect);
+    if (!pr || pr.z > 120 || !inFrame(pr, 0.05)) continue;
+    best = Math.max(best, H / (2 * pr.z * pr.th));
+  }
+  return best;
+};
+
+export const checkCamera = (c: Ctx): Shot[] => {
+  const { ep, frames, th } = c;
+  const K = "camera";
+  const fps = ep.fps;
+
+  // ---- keyframe structure ----
+  const ks = ep.cameras;
+  if (ks.length < 2) { c.add(K, "error", "Fewer than 2 camera keys."); return []; }
+  for (let i = 1; i < ks.length; i++) if (ks[i].t <= ks[i - 1].t) c.add(K, "error", `Camera keys are not strictly increasing at ${fmt(ks[i].t)}.`, ks[i].t);
+  if (ks[0].t > 0.01) c.add(K, "error", `First camera key is at ${fmt(ks[0].t)}, not 0.`);
+  if (ks[ks.length - 1].t < ep.durationSec - 0.01) c.add(K, "error", `Last camera key (${fmt(ks[ks.length - 1].t)}) is before the end of the film.`);
+  for (const k of ks) {
+    if (k.fov < 15 || k.fov > 100) c.add(K, "warn", `FOV ${k.fov}° at ${fmt(k.t)} is outside the natural 15-100° lens range${k.fov > 100 ? " (fisheye distortion)" : ""}.`, k.t);
+  }
+
+  // ---- per-frame motion: scene jumps, zoom smoothness, framing safety ----
+  const jumpFlag: boolean[] = [];
+  const jumpMag: { m: number; deg: number }[] = [];
+  const fovFlag: boolean[] = [];
+  for (let i = 0; i < frames.length; i++) {
+    if (i === 0) { jumpFlag.push(false); jumpMag.push({ m: 0, deg: 0 }); fovFlag.push(false); continue; }
+    const a = frames[i - 1].cam, b = frames[i].cam;
+    const speed = len3(sub3(b.pos, a.pos)) * fps;
+    const fa = norm3(sub3(a.look, a.pos)), fb = norm3(sub3(b.look, b.pos));
+    const deg = (Math.acos(Math.max(-1, Math.min(1, fa[0] * fb[0] + fa[1] * fb[1] + fa[2] * fb[2]))) * 180) / Math.PI;
+    jumpFlag.push(speed > th.jumpSpeed || deg > th.jumpAngle);
+    jumpMag.push({ m: speed / fps, deg });
+    fovFlag.push(Math.abs(b.fov - a.fov) * fps > th.fovRateMax);
+  }
+
+  // group jump frames into events (merge frames < 0.4s apart)
+  const events: { t0: number; t1: number; m: number; deg: number }[] = [];
+  for (const [s, e] of runs(jumpFlag)) {
+    const last = events[events.length - 1];
+    const ev = { t0: frames[s].t, t1: frames[e].t, m: Math.max(...jumpMag.slice(s, e + 1).map((x) => x.m)), deg: Math.max(...jumpMag.slice(s, e + 1).map((x) => x.deg)) };
+    if (last && ev.t0 - last.t1 < 0.4) { last.t1 = ev.t1; last.m = Math.max(last.m, ev.m); last.deg = Math.max(last.deg, ev.deg); } else events.push(ev);
+  }
+
+  let masked = 0, hard = 0;
+  const exits: ("masked" | "hard")[] = [];
+  for (const ev of events) {
+    const cover = ep.transitions.find((tr) => ev.t1 >= tr.t - tr.dur / 2 - th.maskPad && ev.t0 <= tr.t + tr.dur / 2 + th.maskPad);
+    if (cover) { masked++; exits.push("masked"); }
+    else {
+      const hFov = 2 * Math.atan(Math.tan((frames[Math.round(ev.t0 * fps)].cam.fov * Math.PI) / 360) * c.aspect) * (180 / Math.PI);
+      const widths = ev.deg / hFov;
+      const what = `in one frame the camera moves ${ev.m.toFixed(1)} m and turns ${ev.deg.toFixed(0)}° (${widths.toFixed(1)} frame widths) with no transition covering it`;
+      if (widths >= th.hardCutWidths || ev.m > 20) {
+        hard++; exits.push("hard");
+        c.add(K, "error", `Hard cut at ${fmt(ev.t0)}: ${what}. Slow the move, extend the segment, or add an object wipe.`, ev.t0);
+      } else {
+        masked++; exits.push("masked");
+        c.add(K, "warn", `Violent whip-pan at ${fmt(ev.t0)}: ${what}. The content smears and reads close to a cut; lengthen the move.`, ev.t0);
+      }
+    }
+  }
+  for (const [s, e] of runs(fovFlag)) {
+    const t = frames[s].t;
+    if (events.some((ev) => t >= ev.t0 - 0.3 && t <= ev.t1 + 0.3)) continue;
+    c.add(K, "warn", `Zoom at ${fmt(t)}-${fmt(frames[e].t)} changes faster than ${th.fovRateMax}°/s; it will look like a pop, not a smooth zoom.`, t);
+  }
+
+  // ---- shots ----
+  const bounds = [0, ...events.map((e) => (e.t0 + e.t1) / 2), ep.durationSec];
+  const shots: Shot[] = [];
+  for (let i = 0; i < bounds.length - 1; i++) {
+    const i0 = Math.round(bounds[i] * fps), i1 = Math.min(frames.length - 1, Math.round(bounds[i + 1] * fps) - 1);
+    const fr: number[] = [];
+    for (let j = i0; j <= i1; j += 3) fr.push(faceFraction(c, j));
+    fr.sort((a, b) => a - b);
+    const p75 = fr.length ? fr[Math.floor(fr.length * 0.75)] : 0;
+    const midCam = frames[Math.min(frames.length - 1, Math.round((i0 + i1) / 2))].cam;
+    const dist = len3(sub3(midCam.look, midCam.pos));
+    const type: Shot["type"] = p75 >= 0.45 ? "close-up" : p75 >= 0.15 ? "medium" : dist < 22 ? "detail" : "wide";
+    shots.push({ start: bounds[i], end: bounds[i + 1], type, exit: i < events.length ? exits[i] : "end" });
+  }
+  const lens = shots.map((s) => s.end - s.start);
+  c.metrics.shots = shots.length;
+  c.metrics.medianShotSec = +median(lens).toFixed(1);
+  c.metrics.sceneJumps = events.length;
+  c.metrics.hardCuts = hard;
+  c.metrics.maskedJumps = masked;
+  const rate = (events.length / ep.durationSec) * 10;
+  c.metrics.cutsPer10s = +rate.toFixed(2);
+  for (const t of ["wide", "medium", "close-up", "detail"] as const) c.metrics["shots_" + t] = shots.filter((s) => s.type === t).length;
+  if (rate > th.cutsPer10Warn) c.add(K, "warn", `${rate.toFixed(1)} scene changes per 10s (limit ${th.cutsPer10Warn}); the reference films average 0.4 with ~13s shots. Merge scenes or link them with continuous camera moves.`);
+  for (const t of ["wide", "medium", "close-up"] as const) if (!shots.some((s) => s.type === t)) c.add(K, "warn", `No ${t} shot in the whole film; shot variety is missing.`);
+
+  // ---- movement vocabulary (info) ----
+  const tracking = ks.filter((k) => k.target && k.rel).length;
+  const whips = ks.filter((k) => k.whip).length;
+  let zooms = 0;
+  for (let i = 1; i < ks.length; i++) if (Math.abs(ks[i].fov - ks[i - 1].fov) >= 8) zooms++;
+  c.metrics.cam_tracking = tracking; c.metrics.cam_whipPans = whips; c.metrics.cam_zooms = zooms;
+  if (!tracking) c.add(K, "warn", "No tracking (entity-relative) camera keys; the camera never follows a subject.");
+
+  // ---- first face on screen ----
+  let firstFace = -1;
+  for (let i = 0; i < frames.length; i += 2) if (faceFraction(c, i) >= th.faceFrac) { firstFace = frames[i].t; break; }
+  c.metrics.firstFaceSec = firstFace < 0 ? "never" : +firstFace.toFixed(1);
+  if (firstFace < 0) c.add(K, "error", "No character face is ever on screen.");
+  else if (firstFace > th.firstFaceError) c.add(K, "error", `First character face appears at ${fmt(firstFace)}; viewers need a face within ${th.firstFaceWarn}s.`, firstFace);
+  else if (firstFace > th.firstFaceWarn) c.add(K, "warn", `First character face appears at ${fmt(firstFace)} (aim for under ${th.firstFaceWarn}s).`, firstFace);
+
+  // ---- camera safety: clipping, underwater, inside terrain ----
+  // frames fully covered by a wipe hide any camera hazard
+  const covered = frames.map((f) => ep.transitions.some((tr) => Math.abs(f.t - tr.t) <= tr.dur / 2));
+  const hit = { water: [] as boolean[], skim: [] as boolean[], island: [] as boolean[], terrainSkim: [] as boolean[], clip: [] as boolean[] };
+  for (const f of frames) {
+    const [x, y, z] = f.cam.pos;
+    const w = waveHeight(x, z, f.t, c.R.stormAt(f.t));
+    const cv = covered[f.i];
+    hit.water.push(!cv && y < w - 0.05);
+    hit.skim.push(!cv && y >= w - 0.05 && y < w + 0.15);
+    let inside = false, skim = false;
+    for (const s of ep.islands) {
+      const dx = x - s.at[0], dz = z - s.at[1];
+      if (Math.hypot(dx, dz) >= s.radius) continue;
+      const h = hgt(s, dx, dz);
+      if (y < h - 0.05) inside = true; else if (y < h + 0.3) skim = true;
+    }
+    hit.island.push(!cv && inside); hit.terrainSkim.push(!cv && skim && !inside);
+    hit.clip.push(!cv && ep.chars.some((ch) => { const p = c.R.charWorld(ch, f.t); return Math.hypot(p[0] - x, p[2] - z) < th.camClear && y > p[1] && y < p[1] + charHeight(ch.scale); }));
+  }
+  for (const [s, e] of runs(hit.water)) c.add(K, e - s + 1 >= 6 ? "error" : "warn", `Camera is below the water surface at ${fmt(frames[s].t)} for ${((e - s + 1) / fps).toFixed(2)}s${e - s + 1 >= 6 ? "" : " (brief flicker)"}.`, frames[s].t);
+  for (const [s, e] of runs(hit.island)) c.add(K, e - s + 1 >= 6 ? "error" : "warn", `Camera is inside island terrain at ${fmt(frames[s].t)} for ${((e - s + 1) / fps).toFixed(2)}s; the frame will be a blank wash.`, frames[s].t);
+  for (const [s] of runs(hit.skim)) c.add(K, "warn", `Camera skims the water surface at ${fmt(frames[s].t)} (< 0.15 m above a wave crest); it may clip into the swell.`, frames[s].t);
+  for (const [s] of runs(hit.terrainSkim)) c.add(K, "warn", `Camera skims island terrain at ${fmt(frames[s].t)} (< 0.3 m clearance).`, frames[s].t);
+  for (const [s] of runs(hit.clip)) c.add(K, "warn", `Camera passes within ${th.camClear} m of a character at ${fmt(frames[s].t)} (the billboard will fill or clip the frame).`, frames[s].t);
+
+  return shots;
+};
diff --git a/src/history/qc/characters.ts b/src/history/qc/characters.ts
new file mode 100644
index 0000000..6109873
--- /dev/null
+++ b/src/history/qc/characters.ts
@@ -0,0 +1,74 @@
+import { DEFAULT_EXPR, poseAt, type Pose } from "../characters/pose";
+import { charHeight, fmt, inFrame, project, type Ctx } from "./util";
+
+const HEX = /^#[0-9a-fA-F]{6}$/;
+
+export const checkCharacters = (c: Ctx) => {
+  const { ep } = c;
+  const K = "characters";
+
+  // ---------- consistency of the look (single source of truth per id) ----------
+  for (const ch of ep.chars) {
+    const L = ch.look;
+    for (const f of ["skin", "coat", "shirt", "pants", "hatColor", "hair"] as const) if (!HEX.test(L[f])) c.add(K, "error", `"${ch.id}": look.${f} "${L[f]}" is not a #rrggbb colour.`);
+    for (const f of ["sash", "apron"] as const) { const v = L[f]; if (v && !HEX.test(v)) c.add(K, "error", `"${ch.id}": look.${f} "${v}" is not a #rrggbb colour.`); }
+    if (L.build < 0.85 || L.build > 1.3) c.add(K, "warn", `"${ch.id}": build ${L.build} is outside the shared proportion range 0.85-1.3.`);
+    if (ch.scale < 0.5 || ch.scale > 1.3) c.add(K, "warn", `"${ch.id}": scale ${ch.scale} is outside the shared range 0.5-1.3.`);
+  }
+  const named = [ep.story?.protagonist, ...(ep.story?.supporting ?? [])].filter((x): x is string => !!x);
+  for (let a = 0; a < named.length; a++) for (let b = a + 1; b < named.length; b++) {
+    const A = ep.chars.find((x) => x.id === named[a]), B = ep.chars.find((x) => x.id === named[b]);
+    if (A && B && A.look.coat === B.look.coat && A.look.hat === B.look.hat && A.look.hatColor === B.look.hatColor) c.add(K, "warn", `Named characters "${A.id}" and "${B.id}" look identical; viewers cannot tell them apart.`);
+  }
+
+  // ---------- action timelines ----------
+  for (const ch of ep.chars) {
+    if (!ch.actions.length) { c.add(K, "info", `"${ch.id}" has no actions (stands idle all film).`); continue; }
+    for (let i = 1; i < ch.actions.length; i++) {
+      const d = ch.actions[i].t - ch.actions[i - 1].t;
+      if (d < 0) c.add(K, "error", `"${ch.id}": actions are out of order at ${fmt(ch.actions[i].t)}.`, ch.actions[i].t);
+      else if (d < 0.35) c.add(K, "warn", `"${ch.id}": action "${ch.actions[i - 1].a}" lasts only ${d.toFixed(2)}s before "${ch.actions[i].a}"; the pose will flicker.`, ch.actions[i].t);
+    }
+    for (const w of ch.talk ?? []) if (w[1] - w[0] < 0.25) c.add(K, "warn", `"${ch.id}": talk window ${fmt(w[0])}-${fmt(w[1])} is shorter than 0.25s.`, w[0]);
+  }
+  // expression range for the named cast
+  for (const id of named) {
+    const ch = ep.chars.find((x) => x.id === id);
+    if (!ch) continue;
+    const ex = new Set(ch.actions.map((a) => a.expr ?? DEFAULT_EXPR[a.a] ?? "neutral"));
+    if (ex.size < 2) c.add(K, "warn", `Named character "${id}" shows only ${ex.size} facial expression(s); the audience cannot read their feelings.`);
+  }
+
+  // ---------- performance rules from the reference films ----------
+  let blinkFrames = 0, bounceFrames = 0, talkFrames = 0;
+  for (const ch of ep.chars) for (const [a, b] of ch.talk ?? []) {
+    for (let t = a; t <= b; t += 1 / ep.fps) {
+      talkFrames++;
+      const { pose, blink } = poseAt(ch.actions, ch.talk, t, 1, 0);
+      if (blink) blinkFrames++;
+      if (pose.bob > 1.5) bounceFrames++;
+    }
+  }
+  c.metrics.talkFrames = talkFrames;
+  if (blinkFrames) c.add(K, "warn", `Characters blink during ${blinkFrames} speaking frames; nobody blinks while talking in the reference films.`);
+  if (bounceFrames) c.add(K, "warn", `Characters bounce during ${bounceFrames} speaking frames; reference films hold dead still once a character lands.`);
+
+  // pose pops: a limb teleporting between frames, only while the character is on screen
+  let pops = 0, last: { id: string; p: Pose } | null = null;
+  for (const ch of ep.chars) {
+    last = null;
+    for (const f of c.frames) {
+      const pos = c.R.charWorld(ch, f.t);
+      const pr = project(f.cam, [pos[0], pos[1] + charHeight(ch.scale) / 2, pos[2]], c.aspect);
+      if (!pr || pr.z > 90 || !inFrame(pr)) { last = null; continue; }
+      const { pose } = poseAt(ch.actions, ch.talk, f.t, 1, 0);
+      if (last && (Math.abs(pose.armF[0] - last.p.armF[0]) > 0.6 || Math.abs(pose.armB[0] - last.p.armB[0]) > 0.6 || Math.abs(pose.lean - last.p.lean) > 0.25)) {
+        pops++;
+        if (pops <= 5) c.add(K, "warn", `"${ch.id}" pops between poses at ${fmt(f.t)}.`, f.t);
+      }
+      last = { id: ch.id, p: pose };
+    }
+  }
+  c.metrics.posePops = pops;
+  c.add(K, "info", "Known gap: mouth movement is a procedural sine wave in poseAt(), not driven by the narration audio, so true lip-sync is not implemented yet.");
+};
diff --git a/src/history/qc/index.ts b/src/history/qc/index.ts
new file mode 100644
index 0000000..05a4d9c
--- /dev/null
+++ b/src/history/qc/index.ts
@@ -0,0 +1,73 @@
+import type { Episode } from "../types";
+import { makeResolver } from "../engine/entities";
+import { checkAudio } from "./audio";
+import { checkCamera } from "./camera";
+import { checkCharacters } from "./characters";
+import { checkLighting } from "./light";
+import { checkScene } from "./scene";
+import { checkScript } from "./script";
+import type { CheckSummary, Finding, QCOptions, QCReport, Severity, Shot } from "./types";
+import { DEFAULTS, sampleFrames, type Ctx } from "./util";
+
+export type { QCOptions, QCReport, Finding } from "./types";
+
+const ORDER = ["script", "camera", "lighting", "scene", "characters", "audio"];
+
+/** Runs every automated pre-render check on an episode. Pure data: no GPU, no DOM, no rendering. */
+export const runQC = (ep: Episode, opts: QCOptions): QCReport => {
+  const R = makeResolver(ep);
+  const out: Finding[] = [];
+  const metrics: Record<string, number | string> = {};
+  const ctx: Ctx = {
+    ep, R, aspect: opts.aspect, th: { ...DEFAULTS, ...opts.thresholds }, frames: [], dt: 1 / ep.fps, metrics, out,
+    add: (check, severity: Severity, msg, t) => { out.push({ check, severity, msg, t }); },
+  };
+  let shots: Shot[] = [];
+
+  const guard = (name: string, fn: () => void) => {
+    try { fn(); } catch (e) { ctx.add(name, "error", `Check crashed: ${(e as Error).message}. The episode data is probably malformed.`); }
+  };
+
+  // The sampled frames need every camera target to resolve; report that clearly instead of throwing.
+  try { ctx.frames = sampleFrames(ep, R); } catch (e) {
+    ctx.add("camera", "error", `Cannot sample the camera: ${(e as Error).message}`);
+  }
+  guard("script", () => checkScript(ctx));
+  if (ctx.frames.length) {
+    guard("camera", () => { shots = checkCamera(ctx); });
+    guard("scene", () => checkScene(ctx));
+    guard("characters", () => checkCharacters(ctx));
+  }
+  guard("lighting", () => checkLighting(ctx));
+  guard("audio", () => checkAudio(ctx, opts.durations, opts.audioFiles));
+
+  const summary: CheckSummary[] = ORDER.map((check) => ({
+    check,
+    errors: out.filter((f) => f.check === check && f.severity === "error").length,
+    warns: out.filter((f) => f.check === check && f.severity === "warn").length,
+    infos: out.filter((f) => f.check === check && f.severity === "info").length,
+  }));
+  const rank = { error: 0, warn: 1, info: 2 } as const;
+  out.sort((a, b) => ORDER.indexOf(a.check) - ORDER.indexOf(b.check) || rank[a.severity] - rank[b.severity] || (a.t ?? 0) - (b.t ?? 0));
+  return { episode: ep.id, ok: !out.some((f) => f.severity === "error"), summary, metrics, shots, transitions: ep.transitions.map((x) => ({ t: x.t, dur: x.dur })), findings: out };
+};
+
+const ICON = { error: "ERROR", warn: "warn ", info: "info " } as const;
+export const formatReport = (r: QCReport): string => {
+  const L: string[] = [];
+  L.push(`QC report: ${r.episode}   ->   ${r.ok ? "PASS (no errors)" : "FAIL"}`);
+  L.push("");
+  L.push("check       errors  warns  infos");
+  for (const s of r.summary) L.push(`${s.check.padEnd(11)} ${String(s.errors).padStart(6)} ${String(s.warns).padStart(6)} ${String(s.infos).padStart(6)}`);
+  L.push("");
+  L.push("metrics: " + Object.entries(r.metrics).map(([k, v]) => `${k}=${v}`).join("  "));
+  L.push("");
+  L.push("shots: " + r.shots.map((s) => `${s.start.toFixed(1)}-${s.end.toFixed(1)} ${s.type}${s.exit === "hard" ? " [HARD CUT]" : ""}`).join(" | "));
+  L.push("");
+  let cur = "";
+  for (const f of r.findings) {
+    if (f.check !== cur) { cur = f.check; L.push(`[${cur}]`); }
+    L.push(`  ${ICON[f.severity]} ${f.t !== undefined ? `@${f.t.toFixed(1)}s ` : ""}${f.msg}`);
+  }
+  return L.join("\n");
+};
